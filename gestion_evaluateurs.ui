QLineEdit:focus, QComboBox:focus { border: 1px solid #2870e3; }
QPushButton { border-radius: 7px; padding: 10px 17px; font-weight: 600; }
QPushButton#btnAjouter, QPushButton#btnRechercher, QPushButton#btnMetier1 { background: #2468df; color: white; border: none; }
