QPushButton#btnModifier { background: #138b57; color: white; border: none; }
QPushButton#btnSupprimer, QPushButton#btnDeconnexion { background: #dc4545; color: white; border: none; }
QPushButton#btnMetier2 { background: transparent; color: #12845a; border: none; text-align: left; }
QPushButton#menuButton { background: transparent; color: #e6edff; text-align: left; border: none; padding: 13px 15px; font-size: 14px; }
QPushButton#menuButton:checked { background: #2468df; color: white; }
QTableView { background: white; alternate-background-color: #f4f6f9; border: 1px solid #e0e7f1; gridline-color: #e6edf5; selection-background-color: #dce9ff; selection-color: #0b1b42; }
QHeaderView::section { background: #234779; color: white; padding: 13px 8px; border: none; font-weight: 700; }
QTableView QTableCornerButton::section { background: #234779; }
